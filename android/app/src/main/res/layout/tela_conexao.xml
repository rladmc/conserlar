<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:textColor="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true"
    tools:context=".ConexaoActivity"
    tools:ignore="HardcodedText,Autofill,ContentDescription,TouchTargetSizeCheck">

    <Button
        android:id="@+id/btnListarPareados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_list_devices"
        android:textAllCaps="false" />

    <ListView
        android:id="@+id/listViewDispositivos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:textColor="#FFFFFF"/>

    <TextView
        android:id="@+id/textViewStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/status_disconnected"
        android:textStyle="bold"
        android:textColor="#FFFFFF"/>

</LinearLayout>