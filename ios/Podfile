platform :ios, '16.0'

# Requer os pods do Flutter gerados automaticamente
flutter_root = File.expand_path('Flutter', __dir__)
require File.expand_path('packages/flutter_tools/bin/podhelper', flutter_root) if File.exist?(File.expand_path('packages/flutter_tools/bin/podhelper', flutter_root))

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Instala todos os pods necessários pelo Flutter
  install_all_flutter_pods
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end
  end
end
